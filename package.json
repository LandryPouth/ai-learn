{
  "name": "@landry_pouth/ai-learn",
  "version": "0.4.0",
  "description": "Evidence-based learning tracks for AI-assisted learners: init, status, verify and check a learning path with executed proof — not the agent's word.",
  "license": "MIT",
  "author": "Landry Pouth",
  "type": "commonjs",
  "bin": {
    "ai-learn": "./bin/ai-learn.js"
  },
  "files": [
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "flow": "npx @landry_pouth/coding-flow",
    "flow:init": "npx @landry_pouth/coding-flow init",
    "flow:upgrade": "npx @landry_pouth/coding-flow upgrade",
    "flow:doctor": "npx @landry_pouth/coding-flow doctor",
    "flow:fix": "npx @landry_pouth/coding-flow doctor --fix",
    "flow:skills": "npx @landry_pouth/coding-flow list-skills",
    "flow:status": "npx @landry_pouth/coding-flow status",
    "flow:next": "npx @landry_pouth/coding-flow next",
    "flow:check": "npx @landry_pouth/coding-flow doctor --strict",
    "flow:harness": "npx @landry_pouth/coding-flow harness check --quick",
    "flow:commands": "npx @landry_pouth/coding-flow commands",
    "flow:uninstall": "npx @landry_pouth/coding-flow uninstall"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandryPouth/ai-learn.git"
  },
  "homepage": "https://github.com/LandryPouth/ai-learn",
  "bugs": {
    "url": "https://github.com/LandryPouth/ai-learn/issues"
  },
  "keywords": [
    "learning",
    "learning-path",
    "ai",
    "education",
    "pedagogy",
    "active-recall",
    "claude-code",
    "cli",
    "evidence",
    "checkpoint",
    "skill"
  ]
}
