#!/usr/bin/env sh
# generated by ai-learn — commit-msg hook (Conventional Commits). Do not hand-edit;
# re-run `ai-learn update` after changing .githooks/commit-msg's source template.
#
# Escape hatch: `git commit --no-verify` skips this. That bypass is never invisible:
# `ai-learn check` cross-checks recent commit subjects against this same pattern and
# flags any that don't match — same "visible, logged, never silent" spirit as the
# "Corrigé par : IA" journal entry (see AGENTS.md §3).

MSG_FILE="$1"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._-]+\))?!?: .{1,72}'

if ! grep -Eq "$PATTERN" "$MSG_FILE"; then
  echo "✗ Message de commit refusé — format Conventional Commits attendu :" >&2
  echo "    type(scope?): sujet court (≤72 car.)" >&2
  echo "    types : feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Exemple : feat(routes): ajoute GET /users" >&2
  echo "  Échappatoire : git commit --no-verify (visible dans l'historique, jamais silencieux)." >&2
  exit 1
fi
